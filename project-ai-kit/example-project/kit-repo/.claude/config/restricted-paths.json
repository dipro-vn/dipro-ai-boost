{
  "$schema": "single source of truth cho H01 hook + rules/SECURITY.md",
  "description": "Danh sách file/pattern cấm đọc. Sửa file này = sync tự động cho cả hook (block-secret-read.js) và rules/SECURITY.md (dev reference).",
  "denyReadPatterns": [
    "\\.env(\\..+)?$",
    "\\.env$",
    "(^|/)\\.npmrc$",
    "(^|/)\\.yarnrc(\\.yml)?$",
    "(^|/)\\.netrc$",
    "(^|/)\\.gitconfig$",
    "(^|/)\\.ssh/",
    "(^|/)id_(rsa|dsa|ecdsa|ed25519)$",
    "\\.keystore$",
    "\\.jks$",
    "\\.p12$",
    "\\.pfx$",
    "\\.pem$",
    "\\.p8$",
    "\\.key$",
    "\\.cer$",
    "\\.crt$",
    "\\.der$",
    "\\.mobileprovision$",
    "\\.provisionprofile$",
    "google-services\\.json$",
    "GoogleService-Info\\.plist$",
    "firebase_options\\.dart$",
    "(^|/)\\.git/config$",
    "key\\.properties$",
    "keystore\\.properties$",
    "gradle\\.properties$",
    "local\\.properties$",
    "credentials\\.json$",
    "eas\\.json$",
    "(^|/)fastlane/(Appfile|Matchfile|\\.env|\\.session|report\\.xml)",
    "(^|/)\\.expo/",
    "\\.sentryclirc$",
    "sentry\\.properties$",
    "\\.codepushrc$",
    "appcenter-config\\.json$",
    "ormconfig\\.(json|js|yml)$",
    "\\.db$",
    "\\.sqlite3?$",
    "\\.dump$",
    "\\.sql\\.gz$",
    "playwright/\\.auth/",
    "test-users\\.json$"
  ],
  "allowExceptions": [
    "\\.env\\.example$",
    "\\.env\\.sample$",
    "\\.env\\.template$",
    "settings\\.json\\.example$"
  ]
}
