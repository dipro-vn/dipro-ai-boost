# MẪU — copy thành credentials.local.env rồi điền (file .local.env KHÔNG commit, AI không đọc).
# Giá trị có dấu # hoặc khoảng trắng → đặt trong nháy: KEY="giá trị"
# ENV=TEST chỉ khi đã xác nhận là môi trường kiểm thử và tài khoản được cấp để khảo sát.

# --- WEB-01 (website user) ---
WEB-01.URL=https://staging.example.com
WEB-01.ENV=
WEB-01.BASIC_USER=      # tuỳ chọn: HTTP Basic Auth
WEB-01.BASIC_PASS=
WEB-01.user.USER=
WEB-01.user.PASS=

# --- WEB-02 (website admin) — xoá block nếu không có ---
WEB-02.URL=https://staging-admin.example.com
WEB-02.ENV=
WEB-02.admin.USER=
WEB-02.admin.PASS=
